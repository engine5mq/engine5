# Engine5 ve AES image'ları için ortak sürüm bilgisi.
# build-push-docker.sh ve Jenkinsfile'lar bu dosyayı okur; docker build'e VERSION build-arg olarak geçilir.
# Düz KEY=VALUE formatında tutun (shell, Jenkins ve `docker compose --env-file` uyumlu).
IMAGE_TAG=0.0.18-alpha
ENGINE5_IMAGE=hcangunduz/engine5
AES_IMAGE=hcangunduz/engine5-aes
PLATFORMS=linux/amd64,linux/arm64,linux/arm/v7
